{
  "name": "jeu-couples-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend pour le jeu de couples en temps réel",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit",
    "test:verbose": "NODE_OPTIONS='--experimental-vm-modules' jest --verbose --forceExit",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "verify:e2e": "tsx src/__tests__/p0.verify.mts",
    "test:gameplay": "tsx src/__tests__/gameplay/run.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/socket.io-client": "^1.4.36",
    "@types/uuid": "^10.0.0",
    "jest": "^30.2.0",
    "socket.io-client": "^4.8.1",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
